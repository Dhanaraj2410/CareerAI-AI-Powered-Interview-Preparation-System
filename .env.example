# ===================================================================
# CareerAI - Environment Configuration Template
# ===================================================================

# Django Secret Key & Debug Mode
SECRET_KEY=your-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Set USE_MYSQL=True for production MySQL or False for local SQLite
USE_MYSQL=True
DB_NAME=careerai_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# Google Gemini API Configuration (Official google-genai SDK)
# Obtain your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_actual_api_key
GEMINI_MODEL=gemini-2.5-flash
